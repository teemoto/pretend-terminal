{
  "name": "@pretend-terminal/react",
  "version": "0.2.2",
  "description": "React components for Pretend Terminal.",
  "keywords": [
    "terminal",
    "pseudo-terminal",
    "terminal-ui",
    "react",
    "react-component",
    "portfolio",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teemoto/pretend-terminal.git",
    "directory": "packages/react"
  },
  "homepage": "https://teemoto.github.io/pretend-terminal/",
  "bugs": {
    "url": "https://github.com/teemoto/pretend-terminal/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.css"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/styles.css --format esm --dts --clean --external react",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pretend-terminal/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
