{
  "name": "@pretend-terminal/core",
  "version": "0.0.0",
  "description": "Framework-independent pseudo-terminal engine and vanilla JavaScript API.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/styles.css --format esm --dts --clean",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
