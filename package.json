{
  "name": "pretend-terminal",
  "version": "0.0.0",
  "private": true,
  "description": "A safe, configurable pseudo-terminal for the web.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "clean": "corepack pnpm --recursive --if-present run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "corepack pnpm --recursive --if-present run test",
    "typecheck": "corepack pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.16"
  }
}
