{
  "name": "pretend-terminal",
  "version": "0.2.2",
  "private": true,
  "description": "A safe, configurable pseudo-terminal for the web.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "changeset": "changeset",
    "clean": "corepack pnpm --recursive --if-present run clean",
    "dev:demo": "corepack pnpm --filter @pretend-terminal/demo-site dev",
    "dev:react": "corepack pnpm --filter @pretend-terminal/example-react dev",
    "dev:vanilla": "corepack pnpm --filter @pretend-terminal/example-vanilla dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release": "changeset publish",
    "test": "corepack pnpm --recursive --if-present run test",
    "test:e2e": "corepack pnpm --filter @pretend-terminal/example-vanilla build && corepack pnpm --filter @pretend-terminal/example-react build && playwright test",
    "typecheck": "corepack pnpm --filter @pretend-terminal/core build && corepack pnpm --recursive --if-present run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.16"
  }
}
